---
import { t, url } from "../i18n";
import type { Lang } from "../i18n";

const { lang = "en" } = Astro.props;
const T = t(lang);
---

<footer class="border-t border-white/10 mt-32">

  <!-- CMYK color registration bar -->
  <div class="grid grid-cols-4 h-px">
    <div style="background:#00AEEF"></div>
    <div style="background:#EC008C"></div>
    <div style="background:#FFD900"></div>
    <div style="background:#FFFFFF; opacity:0.25"></div>
  </div>

  <div class="container-industrial py-16">
    <div class="grid md:grid-cols-[2fr_1fr_1fr_1fr_1fr] gap-12">

      <!-- Brand column -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <img src="/MainWebsite/logo.svg" alt="InChief" height="32" width="52" />
          <span class="text-sm font-bold tracking-[0.08em]">InChief Printing</span>
        </div>
        <p class="text-white/40 text-xs leading-relaxed max-w-xs">{T.footer.tagline}</p>

        <!-- CMYK dots -->
        <div class="flex gap-2 mt-6">
          <span class="w-4 h-4 rounded-full" style="background:#00AEEF" title="Cyan"></span>
          <span class="w-4 h-4 rounded-full" style="background:#EC008C" title="Magenta"></span>
          <span class="w-4 h-4 rounded-full" style="background:#FFD900" title="Yellow"></span>
          <span class="w-4 h-4 rounded-full" style="background:#1A1A1A; border:1px solid rgba(255,255,255,0.2)" title="Key"></span>
        </div>
      </div>

      <!-- Company — C (Cyan) -->
      <div>
        <p class="label-print mb-5">{T.footer.company}</p>
        <ul class="space-y-2.5 text-xs text-white/50">
          <li><a href={url(lang, "/about")}      class="hover:text-c transition-colors">{T.nav.about}</a></li>
          <li><a href={url(lang, "/industries")} class="hover:text-c transition-colors">{T.nav.industries}</a></li>
          <li><a href={url(lang, "/careers")}    class="hover:text-c transition-colors">{T.nav.careers}</a></li>
          <li><a href={url(lang, "/news")}       class="hover:text-c transition-colors">{T.nav.news}</a></li>
        </ul>
      </div>

      <!-- Solutions — M (Magenta) -->
      <div>
        <p class="label-print label-print-m mb-5">{T.footer.solutions}</p>
        <ul class="space-y-2.5 text-xs text-white/50">
          <li><a href={url(lang, "/solutions/commercial")}   class="hover:text-m transition-colors">{T.service.commercial}</a></li>
          <li><a href={url(lang, "/solutions/folding-carton")} class="hover:text-m transition-colors">{T.service.packaging}</a></li>
          <li><a href={url(lang, "/solutions/uv-varnish")}   class="hover:text-m transition-colors">{T.service.finishing}</a></li>
          <li><a href={url(lang, "/case-studies")}           class="hover:text-m transition-colors">{T.nav.caseStudies}</a></li>
        </ul>
      </div>

      <!-- Quick links — Y (Yellow) -->
      <div>
        <p class="label-print label-print-y mb-5">{T.footer.quickLinks}</p>
        <ul class="space-y-2.5 text-xs text-white/50">
          <li><a href={url(lang, "/equipment")} class="hover:text-y transition-colors">{T.nav.equipment}</a></li>
          <li><a href={url(lang, "/quality")}   class="hover:text-y transition-colors">{T.nav.quality}</a></li>
          <li><a href={url(lang, "/contact")}   class="hover:text-y transition-colors">{T.nav.contactUs}</a></li>
        </ul>
      </div>

      <!-- Contact — K (near-white) -->
      <div>
        <p class="label-print label-print-k mb-5">{T.footer.contactUs}</p>
        <ul class="space-y-3 text-xs text-white/50">
          <li>
            <a href="tel:+8613868530992" class="hover:text-white transition-colors leading-relaxed">
              +86 138-6853-0992
            </a>
            <p class="text-white/25 mt-0.5">
              {lang === 'zh' ? '董事长高级助理 陈先生' :
               lang === 'ar' ? 'السيد چن — مساعد رئيس مجلس الإدارة' :
               lang === 'fr' ? 'M. Chen — Assistant exécutif du président' :
               lang === 'es' ? 'Sr. Chen — Asistente ejecutivo del presidente' :
               lang === 'it' ? 'Sig. Chen — Assistente esecutivo del presidente' :
               'Mr. Chen — Executive Assistant to the Chairman'}
            </p>
          </li>
          <li>
            <a href="mailto:info@InChief.cn" class="hover:text-white transition-colors">
              info@InChief.cn
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom bar — print spec style -->
  <div class="border-t border-white/10">
    <div class="container-industrial py-5 flex flex-col md:flex-row justify-between gap-3 text-[10px] text-white/25 font-mono uppercase tracking-wider">
      <p>© {new Date().getFullYear()} InChief Printing · {T.footer.allRights}</p>
      <p>{T.footer.creditCode}</p>
    </div>
  </div>

</footer>
