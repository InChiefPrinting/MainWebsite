---
import { t, url } from "../i18n";
import type { Lang } from "../i18n";

const { lang = "en" } = Astro.props;
const T = t(lang);
---

<footer class="border-t border-neutral-800 mt-24">
  <div class="container-industrial py-12 grid md:grid-cols-5 gap-10 text-sm">

    <!-- Brand -->
    <div>
      <h3 class="font-semibold mb-4 tracking-widest">InChief Printing</h3>
      <p class="text-neutral-400">{T.footer.tagline}</p>
    </div>

    <!-- Company -->
    <div>
      <h3 class="font-semibold mb-4">{T.footer.company}</h3>
      <ul class="space-y-2 text-neutral-400">
        <li><a href={url(lang, "/about")} class="hover:text-white transition">{T.nav.about}</a></li>
        <li><a href={url(lang, "/industries")} class="hover:text-white transition">{T.nav.industries}</a></li>
        <li><a href={url(lang, "/careers")} class="hover:text-white transition">{T.nav.careers}</a></li>
        <li><a href={url(lang, "/news")} class="hover:text-white transition">{T.nav.news}</a></li>
      </ul>
    </div>

    <!-- Solutions -->
    <div>
      <h3 class="font-semibold mb-4">{T.footer.solutions}</h3>
      <ul class="space-y-2 text-neutral-400">
        <li><a href={url(lang, "/solutions/commercial")} class="hover:text-white transition">{T.service.commercial}</a></li>
        <li><a href={url(lang, "/solutions/folding-carton")} class="hover:text-white transition">{T.service.packaging}</a></li>
        <li><a href={url(lang, "/case-studies")} class="hover:text-white transition">{T.nav.caseStudies}</a></li>
      </ul>
    </div>

    <!-- Quick links -->
    <div>
      <h3 class="font-semibold mb-4">{T.footer.quickLinks}</h3>
      <ul class="space-y-2 text-neutral-400">
        <li><a href={url(lang, "/equipment")} class="hover:text-white transition">{T.nav.equipment}</a></li>
        <li><a href={url(lang, "/quality")} class="hover:text-white transition">{T.nav.quality}</a></li>
        <li><a href={url(lang, "/contact")} class="hover:text-white transition">{T.nav.contactUs}</a></li>
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h3 class="font-semibold mb-4">{T.footer.contactUs}</h3>
      <ul class="text-neutral-400 space-y-2">
        <li>
          <a href="tel:+8613175698111" class="hover:text-white transition">
            +86 131-7569-8111
          </a>
        </li>
        <li>
          <a href="mailto:info@InChief.cn" class="hover:text-white transition">
            info@InChief.cn
          </a>
        </li>
      </ul>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="border-t border-neutral-800">
    <div class="container-industrial py-6 text-xs text-neutral-500 flex flex-col md:flex-row justify-between gap-4">
      <p>© {new Date().getFullYear()} InChief Printing. {T.footer.allRights}</p>
      <p>{T.footer.creditCode}</p>
    </div>
  </div>
</footer>
