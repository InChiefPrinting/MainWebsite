---
import { t, url, switchLangUrl, LOCALES, LANG_NAMES, RTL_LANGS } from "../i18n";
import type { Lang } from "../i18n";
import LogoMark from "./LogoMark.astro";

const { lang = "en" } = Astro.props;
const T = t(lang);
const isRtl = RTL_LANGS.has(lang as Lang);
const currentPath = Astro.url.pathname;

const navItems = [
  {
    label: T.nav.company,
    type: "dropdown",
    children: [
      {
        group: T.nav.overview,
        items: [
          { name: T.nav.about, href: url(lang, "/about") },
          { name: T.nav.industries, href: url(lang, "/industries") },
        ],
      },
      {
        group: T.nav.joinUs,
        items: [{ name: T.nav.careers, href: url(lang, "/careers") }],
      },
      {
        group: T.nav.updates,
        items: [{ name: T.nav.news, href: url(lang, "/news") }],
      },
    ],
  },
  {
    label: T.nav.solutions,
    type: "mega",
    children: [
      {
        group: T.nav.printingSolutions,
        items: [
          { name: T.nav.commercial, href: url(lang, "/solutions/commercial") },
          { name: T.nav.publication, href: url(lang, "/solutions/publication") },
          { name: T.nav.marketing, href: url(lang, "/solutions/marketing") },
          { name: T.nav.vdp, href: url(lang, "/solutions/vdp") },
        ],
      },
      {
        group: T.nav.packagingIndustrial,
        items: [
          { name: T.nav.foldingCarton, href: url(lang, "/solutions/folding-carton") },
          { name: T.nav.rigidBox, href: url(lang, "/solutions/rigid-box") },
          { name: T.nav.labels, href: url(lang, "/solutions/labels") },
          { name: T.nav.industrialPkg, href: url(lang, "/solutions/industrial-packaging") },
        ],
      },
      {
        group: T.nav.finishingEnhancement,
        items: [
          { name: T.nav.uv, href: url(lang, "/solutions/uv-varnish") },
          { name: T.nav.foil, href: url(lang, "/solutions/foil-stamping") },
          { name: T.nav.embossing, href: url(lang, "/solutions/embossing") },
          { name: T.nav.dieCutting, href: url(lang, "/solutions/die-cutting") },
        ],
      },
      {
        group: T.nav.manufacturingServices,
        items: [
          { name: T.nav.customProduction, href: url(lang, "/solutions/custom-production") },
          { name: T.nav.oem, href: url(lang, "/solutions/oem") },
          { name: T.nav.supplyChain, href: url(lang, "/solutions/supply-chain") },
          { name: T.nav.fulfillment, href: url(lang, "/solutions/fulfillment") },
        ],
      },
    ],
  },
];
---

<header class="sticky top-0 z-50 bg-black/95 backdrop-blur-sm border-b border-white/10">
  <nav class="container-industrial flex items-center justify-between h-14">

    <!-- Logo -->
    <a href={url(lang, "/")} class="flex items-center gap-3 shrink-0 group">
      <LogoMark size={28} class="group-hover:opacity-90 transition-opacity" />
      <span class="text-sm font-bold tracking-[0.2em] uppercase">InChief</span>
    </a>

    <!-- Mobile toggle -->
    <button id="menuBtn" class="md:hidden w-8 h-8 flex flex-col justify-center gap-1.5" aria-label="Open menu">
      <span class="block h-px bg-current"></span>
      <span class="block h-px bg-current w-5/6"></span>
      <span class="block h-px bg-current"></span>
    </button>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-6 text-xs font-medium tracking-wider uppercase">

      {navItems.map((item) => (
        <li class="relative group py-4">
          <span class="cursor-default select-none hover:text-c transition-colors">
            {item.label}
          </span>

          {/* ── Company dropdown ── */}
          {item.type === "dropdown" && (
            <div class="absolute left-0 top-full pt-2 hidden group-hover:block z-50">
              <div class="w-52 bg-black border border-white/15 shadow-2xl">
                {item.children.map((group) => (
                  <div class="border-b border-white/10 last:border-none">
                    <div class="px-4 pt-3 pb-1 text-[10px] text-white/30 uppercase tracking-widest">
                      {group.group}
                    </div>
                    {group.items.map((child) => (
                      <a href={child.href}
                        class="flex items-center gap-2 px-4 py-2.5 text-xs normal-case tracking-normal hover:text-c transition-colors">
                        <span class="text-c opacity-0 group-hover:opacity-0">›</span>
                        {child.name}
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* ── Solutions mega menu ── */}
          {item.type === "mega" && (
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 hidden group-hover:block z-50">
              <div class="w-[800px] bg-black border border-white/15 shadow-2xl">
                {/* Cyan top accent line */}
                <div class="h-px bg-c w-full"></div>
                <div class="p-8 grid grid-cols-4 gap-8">
                  {item.children.map((group, gi) => (
                    <div>
                      <p class="text-[10px] text-white/35 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <span class="inline-block w-3 h-px"
                          style={`background: ${gi===0?'#00AEEF':gi===1?'#EC008C':gi===2?'#FFD900':'#888'}`}>
                        </span>
                        {group.group}
                      </p>
                      <div class="space-y-2.5">
                        {group.items.map((child) => (
                          <a href={child.href}
                            class="block text-xs normal-case tracking-normal text-white/70 hover:text-c transition-colors">
                            {child.name}
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </li>
      ))}

      <a href={url(lang, "/equipment")} class="hover:text-c transition-colors">{T.nav.equipment}</a>
      <a href={url(lang, "/case-studies")} class="hover:text-c transition-colors">{T.nav.caseStudies}</a>
      <a href={url(lang, "/quality")} class="hover:text-c transition-colors">{T.nav.quality}</a>

      <!-- Language switcher -->
      <li class="relative group py-4 list-none">
        <button class="flex items-center gap-1.5 hover:text-c transition-colors" aria-label="Language">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span>{lang.toUpperCase()}</span>
        </button>
        <div class="absolute right-0 top-full pt-2 hidden group-hover:block z-50">
          <div class="bg-black border border-white/15 shadow-2xl overflow-hidden">
            <div class="h-px bg-c w-full"></div>
            {LOCALES.map((l) => (
              <a href={switchLangUrl(currentPath, l as Lang)}
                class={`lang-switch-link flex items-center gap-3 px-5 py-2.5 text-xs normal-case tracking-normal hover:text-c transition-colors ${l === lang ? 'text-c' : 'text-white/70'}`}>
                {l === lang && <span class="w-1.5 h-1.5 rounded-full bg-c flex-shrink-0"></span>}
                {l !== lang && <span class="w-1.5 h-1.5 flex-shrink-0"></span>}
                {LANG_NAMES[l as Lang]}
              </a>
            ))}
          </div>
        </div>
      </li>

      <a href={url(lang, "/contact")}
        class="ml-2 px-5 py-2 border border-c text-c text-xs hover:bg-c hover:text-black transition-all font-bold tracking-widest">
        {T.nav.contactUs}
      </a>
    </ul>
  </nav>
</header>

<!-- ═══ Mobile overlay ═══ -->
<div id="mobileMenu" class="fixed inset-0 z-[999] bg-black text-white hidden md:hidden">
  <div class="flex flex-col h-full">

    <!-- Mobile header -->
    <div class="flex justify-between items-center h-14 px-6 border-b border-white/10">
      <span class="flex items-center gap-3">
        <LogoMark size={24} />
        <span class="text-sm font-bold tracking-[0.2em] uppercase">InChief</span>
      </span>
      <button id="closeMenu" class="text-2xl leading-none text-white/60 hover:text-white transition">✕</button>
    </div>

    <div class="flex-1 overflow-y-auto px-6 py-8 space-y-8">

      {navItems.map((item) => (
        <div>
          <p class="text-[10px] uppercase tracking-widest text-white/35 mb-4">{item.label}</p>
          <div class="space-y-5">
            {item.children.map((group) => (
              <div>
                <p class="text-[10px] text-white/25 uppercase tracking-widest mb-2">{group.group}</p>
                <div class="space-y-2 pl-3 border-l border-white/10">
                  {group.items.map((child) => (
                    <a href={child.href} class="block text-sm hover:text-c transition-colors">
                      {child.name}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div>
        <p class="text-[10px] uppercase tracking-widest text-white/35 mb-4">— —</p>
        <div class="space-y-2 pl-3 border-l border-white/10">
          <a href={url(lang, "/equipment")} class="block text-sm hover:text-c transition-colors">{T.nav.equipment}</a>
          <a href={url(lang, "/case-studies")} class="block text-sm hover:text-c transition-colors">{T.nav.caseStudies}</a>
          <a href={url(lang, "/quality")} class="block text-sm hover:text-c transition-colors">{T.nav.quality}</a>
        </div>
      </div>

      <!-- Mobile language grid -->
      <div>
        <p class="text-[10px] uppercase tracking-widest text-white/35 mb-4">Language</p>
        <div class="grid grid-cols-3 gap-2">
          {LOCALES.map((l) => (
            <a href={switchLangUrl(currentPath, l as Lang)}
              class={`lang-switch-link text-center py-2 border text-xs transition-all ${l === lang ? 'border-c text-c' : 'border-white/15 text-white/60 hover:border-white/40'}`}>
              {LANG_NAMES[l as Lang]}
            </a>
          ))}
        </div>
      </div>

    </div>

    <div class="p-6 border-t border-white/10">
      <a href={url(lang, "/contact")}
        class="block w-full text-center py-3.5 bg-c text-black text-xs font-bold tracking-widest uppercase">
        {T.nav.contactUs}
      </a>
    </div>

  </div>
</div>

<script>
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("mobileMenu");
  const close = document.getElementById("closeMenu");

  btn?.addEventListener("click", () => {
    menu?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  });
  close?.addEventListener("click", () => {
    menu?.classList.add("hidden");
    document.body.style.overflow = "";
  });

  // Preserve scroll position across language switches
  const SCROLL_KEY = 'inchief-scroll';
  document.querySelectorAll<HTMLAnchorElement>('.lang-switch-link').forEach((link) => {
    link.addEventListener('click', () => {
      sessionStorage.setItem(SCROLL_KEY, String(window.scrollY));
    });
  });
  const saved = sessionStorage.getItem(SCROLL_KEY);
  if (saved !== null) {
    sessionStorage.removeItem(SCROLL_KEY);
    requestAnimationFrame(() => window.scrollTo({ top: parseInt(saved, 10), behavior: 'instant' }));
  }
</script>
