---
import { t, url, switchLangUrl, LOCALES, LANG_NAMES, RTL_LANGS } from "../i18n";
import type { Lang } from "../i18n";

const { lang = "en" } = Astro.props;
const T = t(lang);
const isRtl = RTL_LANGS.has(lang as Lang);
const currentPath = Astro.url.pathname;

const navItems = [
  {
    label: T.nav.company,
    type: "dropdown",
    children: [
      {
        group: T.nav.overview,
        items: [
          { name: T.nav.about, href: url(lang, "/about") },
          { name: T.nav.industries, href: url(lang, "/industries") },
        ],
      },
      {
        group: T.nav.joinUs,
        items: [{ name: T.nav.careers, href: url(lang, "/careers") }],
      },
      {
        group: T.nav.updates,
        items: [{ name: T.nav.news, href: url(lang, "/news") }],
      },
    ],
  },
  {
    label: T.nav.solutions,
    type: "mega",
    children: [
      {
        group: T.nav.printingSolutions,
        items: [
          { name: T.nav.commercial, href: url(lang, "/solutions/commercial") },
          { name: T.nav.publication, href: url(lang, "/solutions/publication") },
          { name: T.nav.marketing, href: url(lang, "/solutions/marketing") },
          { name: T.nav.vdp, href: url(lang, "/solutions/vdp") },
        ],
      },
      {
        group: T.nav.packagingIndustrial,
        items: [
          { name: T.nav.foldingCarton, href: url(lang, "/solutions/folding-carton") },
          { name: T.nav.rigidBox, href: url(lang, "/solutions/rigid-box") },
          { name: T.nav.labels, href: url(lang, "/solutions/labels") },
          { name: T.nav.industrialPkg, href: url(lang, "/solutions/industrial-packaging") },
        ],
      },
      {
        group: T.nav.finishingEnhancement,
        items: [
          { name: T.nav.uv, href: url(lang, "/solutions/uv-varnish") },
          { name: T.nav.foil, href: url(lang, "/solutions/foil-stamping") },
          { name: T.nav.embossing, href: url(lang, "/solutions/embossing") },
          { name: T.nav.dieCutting, href: url(lang, "/solutions/die-cutting") },
        ],
      },
      {
        group: T.nav.manufacturingServices,
        items: [
          { name: T.nav.customProduction, href: url(lang, "/solutions/custom-production") },
          { name: T.nav.oem, href: url(lang, "/solutions/oem") },
          { name: T.nav.supplyChain, href: url(lang, "/solutions/supply-chain") },
          { name: T.nav.fulfillment, href: url(lang, "/solutions/fulfillment") },
        ],
      },
    ],
  },
];
---

<header class="sticky top-0 z-50 bg-black/90 backdrop-blur border-b border-white/10">
  <nav class="container-industrial flex items-center justify-between h-16">

    <!-- Logo -->
    <a href={url(lang, "/")} class="text-xl font-semibold tracking-widest shrink-0">
      InChief
    </a>

    <!-- Mobile toggle -->
    <button id="menuBtn" class="md:hidden text-2xl leading-none" aria-label="Open menu">
      ☰
    </button>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-5 text-sm">

      {navItems.map((item) => (
        <li class="relative group py-2">
          <span class="cursor-default select-none hover:text-industrial-blue transition">
            {item.label}
          </span>

          {/* ── Normal dropdown ── */}
          {item.type === "dropdown" && (
            <div class="absolute left-0 top-full pt-3 hidden group-hover:block">
              <div class="w-64 bg-neutral-900 border border-white/10 shadow-xl">
                {item.children.map((group) => (
                  <div class="border-b border-white/10 last:border-none">
                    <div class="px-5 py-2 text-xs text-neutral-400 uppercase tracking-wider">
                      {group.group}
                    </div>
                    {group.items.map((child) => (
                      <a href={child.href} class="block px-5 py-3 hover:bg-industrial-blue transition">
                        {child.name}
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* ── Mega menu ── */}
          {item.type === "mega" && (
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 hidden group-hover:block">
              <div class="w-[860px] bg-neutral-900 border border-white/10 shadow-2xl p-8 grid grid-cols-4 gap-8">
                {item.children.map((group) => (
                  <div>
                    <p class="text-xs text-neutral-400 uppercase tracking-wider mb-4">
                      {group.group}
                    </p>
                    <div class="space-y-3">
                      {group.items.map((child) => (
                        <a href={child.href} class="block text-sm hover:text-industrial-blue transition">
                          {child.name}
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </li>
      ))}

      <a href={url(lang, "/equipment")} class="hover:text-industrial-blue transition text-sm">
        {T.nav.equipment}
      </a>
      <a href={url(lang, "/case-studies")} class="hover:text-industrial-blue transition text-sm">
        {T.nav.caseStudies}
      </a>
      <a href={url(lang, "/quality")} class="hover:text-industrial-blue transition text-sm">
        {T.nav.quality}
      </a>

      <!-- Language switcher -->
      <li class="relative group py-2 list-none">
        <button class="flex items-center gap-1.5 text-sm hover:text-industrial-blue transition" aria-label="Language">
          <!-- Globe icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span class="uppercase">{lang}</span>
        </button>
        <div class="absolute right-0 top-full pt-3 hidden group-hover:block">
          <div class="w-40 bg-neutral-900 border border-white/10 shadow-xl py-2">
            {LOCALES.map((l) => (
              <a
                href={switchLangUrl(currentPath, l as Lang)}
                class={`lang-switch-link block px-5 py-2.5 text-sm hover:bg-industrial-blue transition ${l === lang ? 'text-industrial-blue' : 'text-white'}`}
              >
                {LANG_NAMES[l as Lang]}
              </a>
            ))}
          </div>
        </div>
      </li>

      <a
        href={url(lang, "/contact")}
        class="ml-2 px-5 py-2 bg-industrial-blue text-white font-semibold hover:opacity-80 transition text-sm"
      >
        {T.nav.contactUs}
      </a>
    </ul>
  </nav>
</header>

<!-- ═══ Mobile overlay ═══ -->
<div id="mobileMenu" class="fixed inset-0 z-[999] bg-black text-white hidden md:hidden">
  <div class="flex flex-col h-screen">

    <div class="flex justify-between items-center h-16 px-6 border-b border-white/10">
      <span class="text-xl tracking-widest">InChief</span>
      <button id="closeMenu" class="text-3xl leading-none">✕</button>
    </div>

    <div class="flex-1 overflow-y-auto px-6 py-10 space-y-10">

      {navItems.map((item) => (
        <div>
          <p class="text-lg font-semibold mb-5">{item.label}</p>
          <div class="space-y-6">
            {item.children.map((group) => (
              <div>
                <p class="text-xs text-neutral-400 uppercase tracking-wider mb-3">{group.group}</p>
                <div class="space-y-3 pl-2">
                  {group.items.map((child) => (
                    <a href={child.href} class="block text-lg hover:text-industrial-blue transition">
                      {child.name}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="space-y-3">
        <a href={url(lang, "/equipment")} class="block text-lg hover:text-industrial-blue">{T.nav.equipment}</a>
        <a href={url(lang, "/case-studies")} class="block text-lg hover:text-industrial-blue">{T.nav.caseStudies}</a>
        <a href={url(lang, "/quality")} class="block text-lg hover:text-industrial-blue">{T.nav.quality}</a>
      </div>

      <!-- Language switcher mobile -->
      <div>
        <p class="text-xs text-neutral-400 uppercase tracking-wider mb-3">Language</p>
        <div class="grid grid-cols-3 gap-3">
          {LOCALES.map((l) => (
            <a
              href={switchLangUrl(currentPath, l as Lang)}
              class={`lang-switch-link text-center py-2 border transition text-sm ${l === lang ? 'border-industrial-blue text-industrial-blue' : 'border-white/20 hover:border-white'}`}
            >
              {LANG_NAMES[l as Lang]}
            </a>
          ))}
        </div>
      </div>

    </div>

    <div class="p-6 border-t border-white/10">
      <a
        href={url(lang, "/contact")}
        class="block w-full text-center py-4 bg-industrial-blue text-white font-semibold"
      >
        {T.nav.contactUs}
      </a>
    </div>

  </div>
</div>

<script>
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("mobileMenu");
  const close = document.getElementById("closeMenu");

  btn?.addEventListener("click", () => {
    menu?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  });

  close?.addEventListener("click", () => {
    menu?.classList.add("hidden");
    document.body.style.overflow = "";
  });

  // ── Preserve scroll position across language switches ──────────────────
  const SCROLL_KEY = 'inchief-scroll';

  // 1. Save scroll position before navigating to a new language
  document.querySelectorAll<HTMLAnchorElement>('.lang-switch-link').forEach((link) => {
    link.addEventListener('click', () => {
      sessionStorage.setItem(SCROLL_KEY, String(window.scrollY));
    });
  });

  // 2. Restore scroll position after the new page loads
  const saved = sessionStorage.getItem(SCROLL_KEY);
  if (saved !== null) {
    sessionStorage.removeItem(SCROLL_KEY);
    const y = parseInt(saved, 10);
    // requestAnimationFrame ensures the page has rendered before scrolling
    requestAnimationFrame(() => window.scrollTo({ top: y, behavior: 'instant' }));
  }
</script>
