---
const {
  title,
  subtitle,
  buttonText,
  buttonLink
} = Astro.props;
---

<section class="container-industrial py-32">
  <h1 class="text-5xl md:text-7xl font-bold leading-tight max-w-4xl">
    {title}
  </h1>

  <p class="mt-6 text-neutral-400 max-w-2xl">
    {Array.isArray(subtitle)
    ? subtitle.map(line => <span class="block">{line}</span>)
    : subtitle}
  </p>

  <a
    href={buttonLink}
    class="inline-block mt-10 px-8 py-4 bg-industrial-blue text-white rounded"
  >
    {buttonText}
  </a>
</section>