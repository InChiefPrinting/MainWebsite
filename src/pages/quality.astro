---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../layouts/Section.astro";
import Container from "../layouts/Container.astro";
import Content from "../layouts/Content.astro";
import Grid from "../layouts/Grid.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ServiceCard from "../components/ServiceCard.astro";
---

<BaseLayout title="Quality Control | InChief Printing">

<!-- ================= QUALITY ASSURANCE ================= -->
<Section>
  <Container>

    <SectionTitle title="Quality Assurance" />

    <Content>
      <p class="text-neutral-400 mt-6">
        At InChief Printing, quality is not inspected at the end —
        it is engineered into every stage of production.
      </p>
    </Content>

  </Container>
  
</Section>


<!-- ================= CERTIFICATIONS ================= -->
<Section>
  <Container>

    <SectionTitle title="Certifications & Compliance" />

    <Grid cols={3}>

      <ServiceCard
        title="Printing License"
        description="(浙)印证字第1-00698号 · Valid until 31 Dec 2030"
      />

      <ServiceCard
        title="High-Tech Enterprise"
        description="Certificate No. GR202433001592 · Valid until 6 Dec 2027"
      />

      <ServiceCard
        title="Technology SME Certification"
        description="No. 20233303001390"
      />

      <ServiceCard
        title="FSC® Chain of Custody"
        description="Issued by SCS Global Services · FSC-C212511 · SCS-COC-702344 · FSC Mix / Recycled · Valid: 25 Jan 2026 - 22 Jan 2030"
      />

    </Grid>

  </Container>
</Section>


<!-- ================= ISO SYSTEM CERTIFICATIONS ================= -->
<Section>
  <Container>

    <SectionTitle title="Management System Certifications" />

    <Grid cols={3}>

      <ServiceCard
        title="ISO 9001:2015"
        description="Quality Management System · Valid: 28 Feb 2026 - 27 Feb 2029"
      />

      <ServiceCard
        title="ISO 14001:2015"
        description="Environmental Management System · Valid: 28 Feb 2026 - 27 Feb 2029"
      />

      <ServiceCard
        title="ISO 45001:2018"
        description="Occupational Health & Safety Management · Valid: 28 Feb 2026 - 27 Feb 2029"
      />

    </Grid>

  </Container>
</Section>


<!-- ================= CORPORATE INFORMATION ================= -->
<Section>
  <Container>

    <SectionTitle title="Corporate Information" />

    <Grid cols={2}>

      <ServiceCard
        title="Business Registration"
        description="Zhejiang Yunchuang Printing Technology Co., Ltd. · Unified Social Credit Code: 91330383MA2HBRJ43K · Registered Capital: RMB 108.06 Million · Legal Representative: He Jingkan · Established: March 31, 2020 · Location: Longgang, Wenzhou, Zhejiang, China"
      />

      <ServiceCard
        title="Registration Authority"
        description="Longgang Administrative Approval Bureau · Business license available in document archive"
      />

    </Grid>

  </Container>
</Section>

</BaseLayout>