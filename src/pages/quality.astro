---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Quality Control | InChief Printing">

<section class="container-industrial py-24">
  <SectionTitle title="Quality Assurance" />

  <p class="text-neutral-400 max-w-3xl">
    At InChief Printing, quality is not inspected at the end — it is engineered into every stage of production.
  </p>

  <div class="grid md:grid-cols-3 gap-8 mt-16">
    <div class="border border-neutral-800 p-8">Material Inspection</div>
    <div class="border border-neutral-800 p-8">Process Monitoring</div>
    <div class="border border-neutral-800 p-8">Final Inspection</div>
  </div>

  <SectionTitle title="" />
  <SectionTitle title="Certifications & Compliance" />

<div class="grid md:grid-cols-3 gap-8 mt-16">

  <div class="border border-neutral-800 p-8">
    <h3 class="font-semibold">ISO 9001:2015</h3>
    <p class="text-neutral-400 mt-2">
      Quality Management System Certification
    </p>
    <p class="text-neutral-500 text-sm mt-4">
      Status: Historical Certification (Expired)
    </p>
  </div>

  <div class="border border-neutral-800 p-8">
    <h3 class="font-semibold">ISO 14001:2015</h3>
    <p class="text-neutral-400 mt-2">
      Environmental Management System Certification
    </p>
    <p class="text-neutral-500 text-sm mt-4">
      Status: Historical Certification (Expired)
    </p>
  </div>

  <div class="border border-neutral-800 p-8">
    <h3 class="font-semibold">ISO 45001:2018</h3>
    <p class="text-neutral-400 mt-2">
      Occupational Health & Safety Management System
    </p>
    <p class="text-neutral-500 text-sm mt-4">
      Status: Historical Certification (Expired)
    </p>
  </div>

</div>

</section>



</BaseLayout>