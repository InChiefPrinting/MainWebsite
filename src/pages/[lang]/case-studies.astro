---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderImg from "../../components/PlaceholderImg.astro";
import { t, getLangStaticPaths, url } from "../../i18n";
import type { Lang } from "../../i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const T = t(lang);

const cases = [
  { title: T.caseStudies.c1title, tag: T.caseStudies.c1tag, desc: T.caseStudies.c1desc, slug: 'case-luxury-gift-box',         label: 'Premium rigid gift box — foil stamping + embossing' },
  { title: T.caseStudies.c2title, tag: T.caseStudies.c2tag, desc: T.caseStudies.c2desc, slug: 'case-pharma-track-code',        label: 'Pharmaceutical folding carton with track code' },
  { title: T.caseStudies.c3title, tag: T.caseStudies.c3tag, desc: T.caseStudies.c3desc, slug: 'case-oem-corrugated',           label: 'OEM corrugated export carton — stacked pallets' },
  { title: T.caseStudies.c4title, tag: T.caseStudies.c4tag, desc: T.caseStudies.c4desc, slug: 'case-fsc-food-packaging',       label: 'FSC-certified food & beverage folding carton' },
  { title: T.caseStudies.c5title, tag: T.caseStudies.c5tag, desc: T.caseStudies.c5desc, slug: 'case-catalog-8color',           label: '256-page brand catalog — Heidelberg CX104 output' },
  { title: T.caseStudies.c6title, tag: T.caseStudies.c6tag, desc: T.caseStudies.c6desc, slug: 'case-vdp-labels',              label: 'Variable data label roll — serialized barcode' },
];
---

<BaseLayout title={`${T.caseStudies.pageTitle} | InChief`} description={T.meta.description} lang={lang}>

  <section class="container-industrial py-24">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">{T.caseStudies.pageTitle}</h1>
    <p class="text-neutral-400 max-w-2xl">{T.caseStudies.pageSubtitle}</p>
  </section>

  <section class="container-industrial pb-24 border-t border-neutral-800">
    <div class="space-y-0 mt-16">
      {cases.map((c) => (
        <div class="border-b border-neutral-800 py-12 grid md:grid-cols-[280px_1fr_2fr] gap-10 items-start">

          <!-- Thumbnail -->
          <PlaceholderImg slug={c.slug} label={c.label} aspect="4/3" />

          <!-- Title + tags -->
          <div>
            <h2 class="text-xl font-semibold mb-4">{c.title}</h2>
            <div class="flex flex-wrap gap-2">
              {c.tag.split(' · ').map((tag) => (
                <span class="px-3 py-1 border border-industrial-blue text-industrial-blue text-xs">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Description -->
          <div>
            <p class="text-neutral-400 leading-relaxed">{c.desc}</p>
          </div>

        </div>
      ))}
    </div>
  </section>

  <section class="container-industrial py-24 border-t border-neutral-800 text-center">
    <h2 class="text-3xl font-semibold">{T.home.ctaTitle}</h2>
    <p class="text-neutral-400 mt-4">{T.home.ctaText}</p>
    <a href={url(lang as Lang, "/contact")} class="inline-block mt-8 px-8 py-4 bg-industrial-blue text-white font-semibold hover:opacity-80 transition">
      {T.home.ctaBtn}
    </a>
  </section>

</BaseLayout>
