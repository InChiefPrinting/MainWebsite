---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t, getLangStaticPaths, url } from "../../i18n";
import type { Lang } from "../../i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const T = t(lang);
---

<BaseLayout title={T.meta.title} description={T.meta.description} lang={lang}>

  <!-- ═══ HERO ═══ -->
  <section class="container-industrial py-32">
    <h1 class="text-5xl md:text-7xl font-bold leading-tight max-w-4xl">
      {T.hero.title}
    </h1>
    <p class="mt-6 text-neutral-400 max-w-2xl">
      <span class="block">{T.hero.sub1}</span>
      <span class="block mt-1">{T.hero.sub2}</span>
    </p>
    <a
      href={url(lang as Lang, "/contact")}
      class="inline-block mt-10 px-8 py-4 bg-industrial-blue text-white font-semibold hover:opacity-80 transition"
    >
      {T.hero.cta}
    </a>
  </section>

  <!-- ═══ OVERVIEW ═══ -->
  <section class="container-industrial py-24 border-t border-neutral-800">
    <h2 class="text-3xl font-semibold mb-8">{T.home.overviewTitle}</h2>
    <p class="text-neutral-400 max-w-3xl leading-relaxed">
      {T.home.overviewText}
    </p>
  </section>

  <!-- ═══ STATS ═══ -->
  <section class="border-t border-neutral-800">
    <div class="container-industrial">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 divide-neutral-800 border-b border-neutral-800">
        <div class="p-8">
          <p class="text-4xl font-bold text-industrial-blue">1.1M</p>
          <p class="text-neutral-400 text-sm mt-2">
            {lang === 'zh' ? '日产能（印张）' : lang === 'ar' ? 'ورقة يومياً' : lang === 'fr' ? 'Feuilles / jour' : lang === 'es' ? 'Hojas / día' : lang === 'it' ? 'Fogli al giorno' : 'Sheets / Day'}
          </p>
        </div>
        <div class="p-8">
          <p class="text-4xl font-bold text-industrial-blue">16+</p>
          <p class="text-neutral-400 text-sm mt-2">
            {lang === 'zh' ? '印刷解决方案' : lang === 'ar' ? 'حلاً للطباعة' : lang === 'fr' ? 'Solutions d\'impression' : lang === 'es' ? 'Soluciones de impresión' : lang === 'it' ? 'Soluzioni di stampa' : 'Print Solutions'}
          </p>
        </div>
        <div class="p-8">
          <p class="text-4xl font-bold text-industrial-blue">95<span class="text-2xl">/100</span></p>
          <p class="text-neutral-400 text-sm mt-2">
            {lang === 'zh' ? '客户综合满意度' : lang === 'ar' ? 'رضا العملاء الشامل' : lang === 'fr' ? 'Satisfaction client' : lang === 'es' ? 'Satisfacción del cliente' : lang === 'it' ? 'Soddisfazione clienti' : 'Customer Satisfaction'}
          </p>
        </div>
        <div class="p-8">
          <p class="text-4xl font-bold text-industrial-blue">1640<span class="text-2xl">mm</span></p>
          <p class="text-neutral-400 text-sm mt-2">
            {lang === 'zh' ? '最大印刷幅面' : lang === 'ar' ? 'أقصى تنسيق طباعة' : lang === 'fr' ? 'Format max d\'impression' : lang === 'es' ? 'Formato máx. impresión' : lang === 'it' ? 'Formato max di stampa' : 'Max Print Format'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section class="container-industrial py-24 border-t border-neutral-800">
    <h2 class="text-3xl font-semibold mb-12">{T.home.servicesTitle}</h2>
    <div class="grid md:grid-cols-3 gap-8">

      <a href={url(lang as Lang, "/solutions/commercial")} class="border border-neutral-800 p-8 hover:border-industrial-blue transition group block">
        <h3 class="text-xl font-semibold group-hover:text-industrial-blue transition">{T.service.commercial}</h3>
        <p class="text-neutral-400 mt-4">{T.service.commercialDesc}</p>
        <p class="mt-6 text-industrial-blue text-sm">
          {lang === 'zh' ? '了解更多 →' : lang === 'ar' ? 'اعرف المزيد ←' : lang === 'fr' ? 'En savoir plus →' : lang === 'es' ? 'Más información →' : lang === 'it' ? 'Scopri di più →' : 'Learn more →'}
        </p>
      </a>

      <a href={url(lang as Lang, "/solutions/folding-carton")} class="border border-neutral-800 p-8 hover:border-industrial-blue transition group block">
        <h3 class="text-xl font-semibold group-hover:text-industrial-blue transition">{T.service.packaging}</h3>
        <p class="text-neutral-400 mt-4">{T.service.packagingDesc}</p>
        <p class="mt-6 text-industrial-blue text-sm">
          {lang === 'zh' ? '了解更多 →' : lang === 'ar' ? 'اعرف المزيد ←' : lang === 'fr' ? 'En savoir plus →' : lang === 'es' ? 'Más información →' : lang === 'it' ? 'Scopri di più →' : 'Learn more →'}
        </p>
      </a>

      <a href={url(lang as Lang, "/solutions/uv-varnish")} class="border border-neutral-800 p-8 hover:border-industrial-blue transition group block">
        <h3 class="text-xl font-semibold group-hover:text-industrial-blue transition">{T.service.finishing}</h3>
        <p class="text-neutral-400 mt-4">{T.service.finishingDesc}</p>
        <p class="mt-6 text-industrial-blue text-sm">
          {lang === 'zh' ? '了解更多 →' : lang === 'ar' ? 'اعرف المزيد ←' : lang === 'fr' ? 'En savoir plus →' : lang === 'es' ? 'Más información →' : lang === 'it' ? 'Scopri di più →' : 'Learn more →'}
        </p>
      </a>

    </div>
  </section>

  <!-- ═══ TRUSTED EQUIPMENT ═══ -->
  <section class="container-industrial py-16 border-t border-neutral-800">
    <p class="text-xs text-neutral-500 uppercase tracking-widest mb-8 text-center">
      {lang === 'zh' ? '核心设备品牌' : lang === 'ar' ? 'معدات عالمية المستوى' : lang === 'fr' ? 'Équipements de référence' : lang === 'es' ? 'Equipos de referencia' : lang === 'it' ? 'Attrezzature di riferimento' : 'World-Class Equipment'}
    </p>
    <div class="flex flex-wrap justify-center items-center gap-12 text-neutral-500 font-semibold tracking-wider text-sm">
      <span class="hover:text-white transition">HEIDELBERG</span>
      <span class="text-neutral-700">·</span>
      <span class="hover:text-white transition">KOENIG &amp; BAUER</span>
      <span class="text-neutral-700">·</span>
      <span class="hover:text-white transition">KODAK</span>
      <span class="text-neutral-700">·</span>
      <span class="hover:text-white transition">X-RITE</span>
      <span class="text-neutral-700">·</span>
      <span class="hover:text-white transition">FSC® · ISO</span>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="container-industrial py-24 border-t border-neutral-800 text-center">
    <h2 class="text-4xl font-semibold">{T.home.ctaTitle}</h2>
    <p class="text-neutral-400 mt-4 max-w-xl mx-auto">{T.home.ctaText}</p>
    <a
      href={url(lang as Lang, "/contact")}
      class="inline-block mt-8 px-8 py-4 bg-industrial-blue text-white font-semibold hover:opacity-80 transition"
    >
      {T.home.ctaBtn}
    </a>
  </section>

</BaseLayout>
