---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderImg from "../../components/PlaceholderImg.astro";
import { t, getLangStaticPaths, url } from "../../i18n";
import type { Lang } from "../../i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const T = t(lang);

// ── Client logo wall — section copy localized for all 34 languages ──────────
const CLIENTS_LABEL: Record<string, string> = {
  en: 'Trusted By', zh: '合作伙伴', fr: 'Ils nous font confiance', ar: 'يثقون بنا',
  es: 'Confían en nosotros', it: 'Si fidano di noi', ru: 'Нам доверяют', de: 'Vertrauen von',
  ko: '신뢰하는 기업', ja: '信頼される企業', id: 'Dipercaya Oleh', pt: 'Confiam em Nós',
  nl: 'Vertrouwd Door', pl: 'Zaufali Nam', tr: 'Bize Güvenenler', cs: 'Důvěřují Nám',
  hu: 'Megbíznak Bennünk', ro: 'Au Încredere în Noi', el: 'Μας Εμπιστεύονται',
  sv: 'Litar På Oss', da: 'Stoler På Os', no: 'Stoler På Oss', fi: 'Luottavat Meihin',
  uk: 'Нам Довіряють', vi: 'Được Tin Tưởng Bởi', ms: 'Dipercayai Oleh',
  th: 'ได้รับความไว้วางใจจาก', hi: 'हम पर भरोसा', bn: 'আমাদের উপর আস্থা',
  ur: 'ہم پر اعتماد', fa: 'مورد اعتماد', he: 'סומכים עלינו',
  fil: 'Pinagkakatiwalaan Ng', sw: 'Wanaotuamini',
};
const CLIENTS_HEADLINE: Record<string, string> = {
  en: 'Trusted by leading brands worldwide', zh: '深受全球知名品牌信赖',
  fr: 'La confiance des grandes marques mondiales', ar: 'موضع ثقة كبرى العلامات التجارية حول العالم',
  es: 'La confianza de marcas líderes en todo el mundo', it: 'La fiducia dei principali marchi mondiali',
  ru: 'Нам доверяют ведущие мировые бренды', de: 'Vertrauen führender Marken weltweit',
  ko: '전 세계 유수 브랜드가 신뢰합니다', ja: '世界の一流ブランドに信頼されています',
  id: 'Dipercaya merek terkemuka di seluruh dunia', pt: 'A confiança das principais marcas do mundo',
  nl: 'Vertrouwd door toonaangevende merken wereldwijd', pl: 'Zaufanie wiodących marek na całym świecie',
  tr: 'Dünyanın önde gelen markalarının güveni', cs: 'Důvěra předních světových značek',
  hu: 'A vezető globális márkák bizalma', ro: 'Încrederea mărcilor de top din întreaga lume',
  el: 'Η εμπιστοσύνη κορυφαίων μαρκών παγκοσμίως', sv: 'Betrott av ledande varumärken världen över',
  da: 'Betroet af førende brands verden over', no: 'Betrodd av ledende merkevarer verden over',
  fi: 'Johtavien brändien luottamus maailmanlaajuisesti', uk: 'Нам довіряють провідні світові бренди',
  vi: 'Được các thương hiệu hàng đầu thế giới tin tưởng', ms: 'Dipercayai jenama terkemuka di seluruh dunia',
  th: 'ได้รับความไว้วางใจจากแบรนด์ชั้นนำทั่วโลก', hi: 'दुनिया भर के अग्रणी ब्रांडों का भरोसा',
  bn: 'বিশ্বের শীর্ষস্থানীয় ব্র্যান্ডের আস্থা', ur: 'دنیا بھر کے معروف برانڈز کا اعتماد',
  fa: 'مورد اعتماد برندهای پیشرو در سراسر جهان', he: 'מותגים מובילים בעולם סומכים עלינו',
  fil: 'Pinagkakatiwalaan ng mga nangungunang brand sa buong mundo',
  sw: 'Tunaaminiwa na chapa zinazoongoza duniani',
};
const clientsLabel = CLIENTS_LABEL[lang as string] ?? CLIENTS_LABEL.en;
const clientsHeadline = CLIENTS_HEADLINE[lang as string] ?? CLIENTS_HEADLINE.en;

// Abstract greyscale placeholder marks — replace with real client logos
// (drop SVG/PNG files in public/images/clients/ and swap the <svg> for <img>)
const CLIENT_SHAPES = [
  '<circle cx="24" cy="24" r="13"/><circle cx="24" cy="24" r="3.5" fill="currentColor" stroke="none"/>',
  '<circle cx="24" cy="24" r="13"/><line x1="9" y1="24" x2="39" y2="24"/>',
  '<rect x="15" y="15" width="18" height="18" transform="rotate(45 24 24)"/>',
  '<path d="M24 10 L38 36 L10 36 Z"/>',
  '<circle cx="18" cy="24" r="9"/><circle cx="30" cy="24" r="9"/>',
  '<circle cx="24" cy="24" r="13"/><circle cx="24" cy="24" r="6.5"/>',
];
---

<BaseLayout title={T.meta.title} description={T.meta.description} lang={lang}>

  <!-- ═══ HERO ═══ -->
  <section class="relative overflow-hidden min-h-[calc(100vh-3.5rem)] flex flex-col justify-center">

    <!-- Halftone dot texture (top-right quadrant) -->
    <div class="halftone absolute top-0 right-0 w-1/2 h-full pointer-events-none opacity-60"></div>

    <!-- Cyan vertical accent bar -->
    <div class="absolute top-0 left-0 bottom-0 w-1" style="background:#00AEEF"></div>

    <!-- Registration mark — top right -->
    <div class="absolute top-10 right-10 text-white/15">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="0.75"/>
        <circle cx="20" cy="20" r="9"  stroke="currentColor" stroke-width="0.75"/>
        <line x1="0" y1="20" x2="40" y2="20" stroke="currentColor" stroke-width="0.75"/>
        <line x1="20" y1="0" x2="20" y2="40" stroke="currentColor" stroke-width="0.75"/>
      </svg>
    </div>

    <div class="container-industrial py-20 relative">

      <!-- Label -->
      <p class="label-print mb-8">
        {lang === 'zh' ? '浙江云创印刷科技有限公司' :
         lang === 'ar' ? 'Zhejiang InChief Printing Technology' :
         'Zhejiang InChief Printing Technology Co., Ltd.'}
      </p>

      <!-- Main headline -->
      <h1 class="text-[clamp(2.5rem,7vw,6rem)] font-black leading-[1.05] tracking-tight max-w-5xl">
        {T.hero.title}
      </h1>

      <!-- Cyan rule + subtext -->
      <div class="flex items-start gap-6 mt-10 max-w-2xl">
        <div class="w-px bg-c self-stretch flex-shrink-0 min-h-[3rem]"></div>
        <div class="space-y-1">
          <p class="text-white/60 text-lg">{T.hero.sub1}</p>
          <p class="text-white/40 text-base">{T.hero.sub2}</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="flex items-center gap-6 mt-12">
        <a href={url(lang as Lang, "/contact")}
          class="inline-flex items-center gap-3 px-8 py-4 bg-c text-black font-bold text-sm tracking-widest uppercase hover:opacity-80 transition-opacity">
          {T.hero.cta}
          <span aria-hidden="true">→</span>
        </a>
        <a href={url(lang as Lang, "/solutions/commercial")}
          class="text-sm text-white/40 hover:text-c transition-colors tracking-widest uppercase">
          {T.nav.solutions} ↓
        </a>
      </div>

    </div>
  </section>

  <!-- ═══ STATS STRIP ═══ -->
  <section class="border-y border-white/10">
    <div class="container-industrial">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 divide-white/10">

        {[
          { value: '1.1M', unit: lang==='zh'?'印张/天':lang==='ar'?'ورقة/يوم':lang==='fr'?'feuilles/j':lang==='es'?'hojas/día':lang==='it'?'fogli/g':'sheets/day', color: '#00AEEF' },
          { value: '95',   unit: lang==='zh'?'客户满意度':lang==='ar'?'رضا العملاء':lang==='fr'?'satisfaction':lang==='es'?'satisfacción':lang==='it'?'soddisfazione':'/100 satisfaction', color: '#EC008C' },
          { value: '16+',  unit: lang==='zh'?'印刷方案':lang==='ar'?'حلاً للطباعة':lang==='fr'?'solutions':lang==='es'?'soluciones':lang==='it'?'soluzioni':'solutions', color: '#FFD900' },
          { value: '1640', unit: 'mm max format', color: '', kColor: true },
        ].map((s) => (
          <div class="p-8 group">
            <p class={`stat-num text-5xl ${s.kColor ? 'k-color' : ''}`} style={s.color ? `color:${s.color}` : ''}>{s.value}</p>
            <p class="text-[10px] uppercase tracking-widest text-white/35 mt-3">{s.unit}</p>
          </div>
        ))}

      </div>
    </div>
  </section>

  <!-- ═══ OVERVIEW ═══ -->
  <section class="container-industrial py-28">
    <div class="grid md:grid-cols-[1fr_2fr] gap-16 items-start">
      <div>
        <p class="label-print mb-6">{T.home.overviewTitle}</p>
        <!-- CMYK process marks -->
        <div class="flex gap-3 mt-8">
          {['C','M','Y','K'].map((ch, i) => (
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-7 h-7 rounded-full" style={`background:${i===0?'#00AEEF':i===1?'#EC008C':i===2?'#FFD900':'#fff'};opacity:${i===3?0.15:1}`}></div>
              <span class="text-[9px] font-mono text-white/25">{ch}</span>
            </div>
          ))}
        </div>
      </div>
      <div>
        <p class="text-xl text-white/70 leading-relaxed">{T.home.overviewText}</p>
      </div>
    </div>
  </section>

  <!-- ═══ FACTORY IMAGE ═══ -->
  <section class="container-industrial pb-4">
    <PlaceholderImg
      slug="factory-floor-overview"
      label="Production floor — full press line overview"
      aspect="21/9"
    />
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section class="container-industrial pb-28">
    <p class="label-print mb-12">{T.home.servicesTitle}</p>
    <div class="grid md:grid-cols-3 gap-px bg-white/10">

      <a href={url(lang as Lang, "/solutions/commercial")}
        class="crop-card bg-black p-10 group hover:bg-white/5 transition-colors">
        <div class="w-1 h-8 bg-c mb-8 group-hover:h-12 transition-all"></div>
        <h3 class="text-xl font-bold mb-4 group-hover:text-c transition-colors">{T.service.commercial}</h3>
        <p class="text-white/50 text-sm leading-relaxed">{T.service.commercialDesc}</p>
        <p class="mt-8 text-c text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
          {lang==='zh'?'了解更多':lang==='ar'?'اعرف المزيد':lang==='fr'?'En savoir plus':lang==='es'?'Más información':lang==='it'?'Scopri di più':'Explore'} →
        </p>
      </a>

      <a href={url(lang as Lang, "/solutions/folding-carton")}
        class="crop-card bg-black p-10 group hover:bg-white/5 transition-colors">
        <div class="w-1 h-8 bg-m mb-8 group-hover:h-12 transition-all"></div>
        <h3 class="text-xl font-bold mb-4 group-hover:text-m transition-colors">{T.service.packaging}</h3>
        <p class="text-white/50 text-sm leading-relaxed">{T.service.packagingDesc}</p>
        <p class="mt-8 text-m text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
          {lang==='zh'?'了解更多':lang==='ar'?'اعرف المزيد':lang==='fr'?'En savoir plus':lang==='es'?'Más información':lang==='it'?'Scopri di più':'Explore'} →
        </p>
      </a>

      <a href={url(lang as Lang, "/solutions/uv-varnish")}
        class="crop-card bg-black p-10 group hover:bg-white/5 transition-colors">
        <div class="w-1 h-8 bg-y mb-8 group-hover:h-12 transition-all"></div>
        <h3 class="text-xl font-bold mb-4 group-hover:text-y transition-colors">{T.service.finishing}</h3>
        <p class="text-white/50 text-sm leading-relaxed">{T.service.finishingDesc}</p>
        <p class="mt-8 text-y text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
          {lang==='zh'?'了解更多':lang==='ar'?'اعرف المزيد':lang==='fr'?'En savoir plus':lang==='es'?'Más información':lang==='it'?'Scopri di più':'Explore'} →
        </p>
      </a>

    </div>
  </section>

  <!-- ═══ EQUIPMENT BRANDS STRIP ═══ -->
  <section class="border-y border-white/10 py-10">
    <div class="container-industrial">
      <div class="flex flex-wrap items-center justify-between gap-8">
        <p class="label-print">
          {lang==='zh'?'核心设备':lang==='ar'?'معدات رئيسية':lang==='fr'?'Équipements':lang==='es'?'Equipos':lang==='it'?'Attrezzature':'Equipment'}
        </p>
        <div class="flex flex-wrap gap-10 text-white/25 font-bold text-xs tracking-[0.2em] uppercase">
          <span class="hover:text-c transition-colors">HEIDELBERG</span>
          <span class="text-white/10">·</span>
          <span class="hover:text-c transition-colors">KOENIG &amp; BAUER</span>
          <span class="text-white/10">·</span>
          <span class="hover:text-c transition-colors">KODAK</span>
          <span class="text-white/10">·</span>
          <span class="hover:text-c transition-colors">X-RITE</span>
        </div>
        <a href={url(lang as Lang, "/equipment")}
          class="text-xs text-c uppercase tracking-widest hover:opacity-70 transition-opacity">
          {T.nav.equipment} →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ CLIENTS / TRUSTED BY ═══ -->
  <section class="container-industrial py-24">
    <div class="text-center mb-14">
      <p class="label-print justify-center mb-5">{clientsLabel}</p>
      <p class="text-2xl md:text-3xl font-black max-w-2xl mx-auto leading-tight">{clientsHeadline}</p>
    </div>

    <!-- Logo grid — borders form the cell lines (visible in both themes) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 border-l border-t border-white/10">
      {Array.from({ length: 12 }).map((_, i) => (
        <div class="client-cell aspect-[3/2] flex items-center justify-center border-r border-b border-white/10">
          <svg
            width="46" height="46" viewBox="0 0 48 48"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"
            set:html={CLIENT_SHAPES[i % CLIENT_SHAPES.length]}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="container-industrial py-32">
    <div class="relative overflow-hidden border border-white/10 p-16">
      <!-- Background halftone -->
      <div class="halftone absolute inset-0 opacity-40 pointer-events-none"></div>
      <!-- Cyan corner accent -->
      <div class="absolute top-0 left-0 w-24 h-1 bg-c"></div>
      <div class="absolute top-0 left-0 w-1 h-24 bg-c"></div>
      <div class="relative">
        <p class="label-print mb-6">{T.home.ctaTitle}</p>
        <p class="text-4xl md:text-5xl font-black leading-tight max-w-2xl mb-10">{T.home.ctaText}</p>
        <a href={url(lang as Lang, "/contact")}
          class="inline-flex items-center gap-3 px-10 py-5 bg-c text-black font-bold text-sm tracking-widest uppercase hover:opacity-80 transition-opacity">
          {T.home.ctaBtn} →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Client logo wall ────────────────────────────────────────────────
     Placeholder marks sit greyscale, then light up in CMYK order on hover
     (Cyan · Magenta · Yellow · Key) — the press palette of the whole site. */
  .client-cell svg {
    color: rgba(255, 255, 255, 0.16);
    transition: color 0.3s ease, transform 0.3s ease;
  }
  .client-cell:hover { background: rgba(255, 255, 255, 0.03); }
  .client-cell:hover svg { transform: scale(1.1); }
  .client-cell:nth-child(4n+1):hover svg { color: #00AEEF; }
  .client-cell:nth-child(4n+2):hover svg { color: #EC008C; }
  .client-cell:nth-child(4n+3):hover svg { color: #FFD900; }
  .client-cell:nth-child(4n+4):hover svg { color: rgba(255, 255, 255, 0.7); }

  :global([data-theme="light"]) .client-cell svg { color: rgba(0, 0, 0, 0.18); }
  :global([data-theme="light"]) .client-cell:hover { background: rgba(0, 0, 0, 0.03); }
  :global([data-theme="light"]) .client-cell:nth-child(4n+4):hover svg { color: rgba(0, 0, 0, 0.65); }
</style>
