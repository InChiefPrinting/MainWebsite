---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t, getLangStaticPaths } from "../../i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const T = t(lang);
---

<BaseLayout title={`${T.contact.pageTitle} | InChief`} description={T.meta.description} lang={lang}>

  <section class="container-industrial py-24">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">{T.contact.pageTitle}</h1>
    <p class="text-neutral-400 max-w-2xl">{T.contact.pageSubtitle}</p>
  </section>

  <section class="container-industrial pb-24 border-t border-neutral-800">
    <div class="grid md:grid-cols-2 gap-16 pt-16">

      <!-- Contact Info -->
      <div class="space-y-10">

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-2">{T.contact.phone}</p>
          <a href="tel:+8613868530992" class="text-2xl font-semibold hover:text-industrial-blue transition">
            +86 138-6853-0992
          </a>
          <p class="text-sm text-neutral-500 mt-1">
            {lang === 'zh' ? '董事长高级助理 陈先生' :
             lang === 'ar' ? 'السيد چن — مساعد رئيس مجلس الإدارة' :
             lang === 'fr' ? 'M. Chen — Assistant exécutif du président' :
             lang === 'es' ? 'Sr. Chen — Asistente ejecutivo del presidente' :
             lang === 'it' ? 'Sig. Chen — Assistente esecutivo del presidente' :
             'Mr. Chen — Executive Assistant to the Chairman'}
          </p>
        </div>

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-2">{T.contact.email}</p>
          <a href="mailto:info@InChief.cn" class="text-2xl font-semibold hover:text-industrial-blue transition">
            info@InChief.cn
          </a>
        </div>

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-2">{T.contact.address}</p>
          <p class="text-lg leading-relaxed">{T.contact.addressText}</p>
        </div>

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-2">{T.contact.hours}</p>
          <p class="text-lg">{T.contact.hoursText}</p>
        </div>

      </div>

      <!-- Inquiry form -->
      <form
        action="mailto:info@InChief.cn"
        method="post"
        enctype="text/plain"
        class="space-y-6"
      >
        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-widest mb-2">
            {lang === 'zh' ? '姓名' : lang === 'ar' ? 'الاسم' : lang === 'fr' ? 'Nom' : lang === 'es' ? 'Nombre' : lang === 'it' ? 'Nome' : 'Name'}
          </label>
          <input
            type="text"
            name="name"
            required
            class="w-full bg-transparent border border-neutral-700 px-4 py-3 text-white focus:border-industrial-blue focus:outline-none transition"
            placeholder={lang === 'zh' ? '您的姓名' : lang === 'ar' ? 'اسمك الكامل' : lang === 'fr' ? 'Votre nom' : lang === 'es' ? 'Su nombre' : lang === 'it' ? 'Il tuo nome' : 'Your name'}
          />
        </div>

        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-widest mb-2">
            {lang === 'zh' ? '电子邮箱' : lang === 'ar' ? 'البريد الإلكتروني' : lang === 'fr' ? 'E-mail' : lang === 'es' ? 'Correo electrónico' : lang === 'it' ? 'E-mail' : 'Email'}
          </label>
          <input
            type="email"
            name="email"
            required
            class="w-full bg-transparent border border-neutral-700 px-4 py-3 text-white focus:border-industrial-blue focus:outline-none transition"
            placeholder="you@company.com"
          />
        </div>

        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-widest mb-2">
            {lang === 'zh' ? '公司名称' : lang === 'ar' ? 'اسم الشركة' : lang === 'fr' ? 'Société' : lang === 'es' ? 'Empresa' : lang === 'it' ? 'Azienda' : 'Company'}
          </label>
          <input
            type="text"
            name="company"
            class="w-full bg-transparent border border-neutral-700 px-4 py-3 text-white focus:border-industrial-blue focus:outline-none transition"
            placeholder={lang === 'zh' ? '您的公司' : lang === 'ar' ? 'شركتك' : lang === 'fr' ? 'Votre société' : lang === 'es' ? 'Su empresa' : lang === 'it' ? 'La tua azienda' : 'Your company'}
          />
        </div>

        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-widest mb-2">
            {lang === 'zh' ? '询盘内容' : lang === 'ar' ? 'رسالتك' : lang === 'fr' ? 'Message' : lang === 'es' ? 'Mensaje' : lang === 'it' ? 'Messaggio' : 'Message'}
          </label>
          <textarea
            name="message"
            rows={5}
            required
            class="w-full bg-transparent border border-neutral-700 px-4 py-3 text-white focus:border-industrial-blue focus:outline-none transition resize-none"
            placeholder={lang === 'zh' ? '请描述您的印刷需求…' : lang === 'ar' ? 'صف احتياجاتك من الطباعة…' : lang === 'fr' ? 'Décrivez vos besoins en impression…' : lang === 'es' ? 'Describa sus necesidades de impresión…' : lang === 'it' ? 'Descrivi le tue esigenze di stampa…' : 'Describe your printing requirements…'}
          ></textarea>
        </div>

        <button
          type="submit"
          class="px-8 py-4 bg-industrial-blue text-white font-semibold hover:opacity-80 transition w-full md:w-auto"
        >
          {lang === 'zh' ? '发送询盘' : lang === 'ar' ? 'إرسال الطلب' : lang === 'fr' ? 'Envoyer la demande' : lang === 'es' ? 'Enviar consulta' : lang === 'it' ? 'Invia richiesta' : 'Send Inquiry'}
        </button>
      </form>

    </div>
  </section>

  <!-- ═══ COMPANY INFO ═══ -->
  <section class="container-industrial pb-24">
    <div class="border border-neutral-800 p-10 space-y-8 max-w-2xl">
      <!-- Info panel -->
      <div class="space-y-8">

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-1">
            {lang === 'zh' ? '公司全称' : lang === 'ar' ? 'الاسم الرسمي' : lang === 'fr' ? 'Raison sociale' : lang === 'es' ? 'Razón social' : lang === 'it' ? 'Ragione sociale' : 'Legal Name'}
          </p>
          <p class="text-sm">浙江云创印刷科技有限公司</p>
          <p class="text-sm text-neutral-400">Zhejiang InChief Printing Technology Co., Ltd.</p>
        </div>

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-1">
            {lang === 'zh' ? '统一社会信用代码' : lang === 'ar' ? 'رمز الائتمان الاجتماعي' : lang === 'fr' ? 'Code de crédit social' : lang === 'es' ? 'Código de crédito social' : lang === 'it' ? 'Codice di credito sociale' : 'Unified Social Credit Code'}
          </p>
          <p class="text-sm font-mono">913330383MA2HBRJ43K</p>
        </div>

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-1">
            {lang === 'zh' ? '法定代表人' : lang === 'ar' ? 'الممثل القانوني' : lang === 'fr' ? 'Représentant légal' : lang === 'es' ? 'Representante legal' : lang === 'it' ? 'Rappresentante legale' : 'Legal Representative'}
          </p>
          <p class="text-sm">何经刊 (He Jingkan)</p>
        </div>

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-1">
            {lang === 'zh' ? '成立日期' : lang === 'ar' ? 'تاريخ التأسيس' : lang === 'fr' ? 'Date de fondation' : lang === 'es' ? 'Fecha de fundación' : lang === 'it' ? 'Data di fondazione' : 'Founded'}
          </p>
          <p class="text-sm">March 31, 2020 / 2020年3月31日</p>
        </div>

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-1">
            {lang === 'zh' ? '注册资本' : lang === 'ar' ? 'رأس المال المسجل' : lang === 'fr' ? 'Capital enregistré' : lang === 'es' ? 'Capital registrado' : lang === 'it' ? 'Capitale registrato' : 'Registered Capital'}
          </p>
          <p class="text-sm">RMB 108,060,000 / 壹亿零捌佰零陆万元整</p>
        </div>

      </div>

    </div>
  </section>

</BaseLayout>
