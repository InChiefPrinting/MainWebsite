---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { t, getLangStaticPaths, url } from "../../../i18n";
import type { Lang } from "../../../i18n";
import { getSolution, SOLUTION_SLUGS } from "../../../i18n/solutions";

export function getStaticPaths() {
  const langs = getLangStaticPaths().map((p) => p.params.lang as Lang);
  return langs.flatMap((lang) =>
    SOLUTION_SLUGS.map((solution) => ({ params: { lang, solution } }))
  );
}

const { lang, solution } = Astro.params;
const T = t(lang);
const content = getSolution(solution, lang as Lang);

// If slug is invalid, content will be null — redirect to home
if (!content) {
  return Astro.redirect(url(lang as Lang, "/"));
}
---

<BaseLayout
  title={`${content.title} | InChief`}
  description={content.tagline}
  lang={lang}
>

  <!-- Hero -->
  <section class="container-industrial py-24">
    <p class="text-industrial-blue text-sm font-semibold uppercase tracking-widest mb-4">
      {T.nav.solutions}
    </p>
    <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">
      {content.title}
    </h1>
    <p class="text-xl text-neutral-300 max-w-2xl">{content.tagline}</p>
  </section>

  <!-- Intro -->
  <section class="container-industrial pb-16 border-t border-neutral-800">
    <div class="mt-16 max-w-3xl">
      <p class="text-neutral-300 leading-relaxed text-lg">{content.intro}</p>
    </div>
  </section>

  <!-- Features + Specs -->
  <section class="container-industrial pb-24">
    <div class="grid md:grid-cols-2 gap-16">

      <!-- Features -->
      <div>
        <h2 class="text-2xl font-semibold mb-8 border-b border-neutral-800 pb-4">
          {lang === 'zh' ? '核心优势' :
           lang === 'fr' ? 'Points forts' :
           lang === 'ar' ? 'المزايا الرئيسية' :
           lang === 'es' ? 'Características clave' :
           lang === 'it' ? 'Caratteristiche principali' :
           'Key Features'}
        </h2>
        <ul class="space-y-4">
          {content.features.map((feature) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-2 h-2 rounded-full bg-industrial-blue flex-shrink-0"></span>
              <span class="text-neutral-300">{feature}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Specs -->
      <div>
        <h2 class="text-2xl font-semibold mb-8 border-b border-neutral-800 pb-4">
          {lang === 'zh' ? '技术规格' :
           lang === 'fr' ? 'Spécifications' :
           lang === 'ar' ? 'المواصفات الفنية' :
           lang === 'es' ? 'Especificaciones' :
           lang === 'it' ? 'Specifiche tecniche' :
           'Specifications'}
        </h2>
        <dl class="space-y-0">
          {content.specs.map((spec) => (
            <div class="flex justify-between py-4 border-b border-neutral-800 last:border-0">
              <dt class="text-neutral-400 text-sm">{spec.label}</dt>
              <dd class="font-semibold text-sm text-right">{spec.value}</dd>
            </div>
          ))}
        </dl>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="container-industrial py-24 border-t border-neutral-800 text-center">
    <h2 class="text-3xl font-semibold">{T.home.ctaTitle}</h2>
    <p class="text-neutral-400 mt-4 max-w-xl mx-auto">{T.home.ctaText}</p>
    <a
      href={url(lang as Lang, "/contact")}
      class="inline-block mt-8 px-8 py-4 bg-industrial-blue text-white font-semibold hover:opacity-80 transition"
    >
      {T.home.ctaBtn}
    </a>
  </section>

</BaseLayout>
