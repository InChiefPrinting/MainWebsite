---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../layouts/Section.astro";
import Container from "../layouts/Container.astro";
import Content from "../layouts/Content.astro";
import Grid from "../layouts/Grid.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ServiceCard from "../components/ServiceCard.astro";
---

<BaseLayout title="Equipment | InChief Printing">

<!-- ================= INTRO ================= -->
<Section>
  <Container>

    <SectionTitle title="Production Equipment" />

    <Content>
      <p class="text-neutral-400 mt-6">
        Our production facility is equipped with world-class offset printing systems,
        automated prepress workflow, and precision finishing machinery to ensure
        stable industrial-grade output.
      </p>
    </Content>

  </Container>
</Section>


<!-- ================= OFFSET PRESSES ================= -->
<Section>
  <Container>

    <SectionTitle title="Offset Presses" />

    <Grid cols={3}>

      <ServiceCard
        title="Heidelberg Speedmaster"
        subtitle="CX 104-8 + LYY-2 + L"
        description="High-speed sheetfed offset press"
      />

      <ServiceCard
        title="Heidelberg Speedmaster"
        subtitle="XL75-6"
        description="Precision commercial printing system"
      />

      <ServiceCard
        title="Heidelberg Speedmaster"
        subtitle="XL106-6"
        description="Large-format sheetfed offset press"
      />

      <ServiceCard
        title="Koenig & Bauer"
        subtitle="Rapida 105-5+L"
        description="Multi-color offset production line"
      />

      <ServiceCard
        title="Koenig & Bauer"
        subtitle="RA105-8+L"
        description="High-efficiency packaging printing press"
      />

      <ServiceCard
        title="Heidelberg Speedmaster"
        subtitle="XL75-7+L"
        description="Advanced color control offset system"
      />

      <ServiceCard
        title="Koenig & Bauer"
        subtitle="RA164-5"
        description="Large-format industrial printing press"
      />

    </Grid>

  </Container>
</Section>


<!-- ================= CTP ================= -->
<Section>
  <Container>

    <SectionTitle title="CTP Platesetters" />

    <Grid cols={3}>

      <ServiceCard
        title="Eastman Kodak"
        subtitle="Trendsetter Q800AL"
        description="CTP platesetter with autoloader system"
      />

      <ServiceCard
        title="Eastman Kodak"
        subtitle="Trendsetter Q1600"
        description="High-precision CTP imaging system"
      />

    </Grid>

  </Container>
</Section>


<!-- ================= FINISHING ================= -->
<Section>
  <Container>

    <SectionTitle title="Finishing Equipment" />

    <Grid cols={3}>

      <ServiceCard
        title="Guowang"
        subtitle="GW137P"
        description="Automated paper guillotine cutter"
      />

      <ServiceCard
        title="Guowang"
        subtitle="GW137S"
        description="High-precision cutting system"
      />

      <ServiceCard
        title="Guowang"
        subtitle="GW176S"
        description="Heavy-duty industrial cutter"
      />

    </Grid>

  </Container>
</Section>

</BaseLayout>