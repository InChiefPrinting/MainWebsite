---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Equipment | InChief Printing">

<section class="container-industrial py-24">
  <SectionTitle title="Production Equipment" />

  <SectionTitle title="Offset Presses" />
  <div class="grid md:grid-cols-3 gap-8 mt-12">
    <div class="border border-neutral-800 p-8">
      <div>Heidelberg Speedmaster</div>
      <div>CX 104‑8 + LYY‑2 + L</div>
      <div>Sheetfed Offset Press</div>
    </div>

    <div class="border border-neutral-800 p-8">
      <div>Heidelberg Speedmaster</div>
      <div>XL75-6</div>
      <div>Sheetfed Offset Press</div>
    </div>

    <div class="border border-neutral-800 p-8">
      <div>Heidelberg Speedmaster</div>
      <div>XL106-6</div>
      <div>Sheetfed Offset Press</div>
    </div>

    <div class="border border-neutral-800 p-8">
      <div>Koenig & Bauer</div>
      <div>Rapida 105-5+L</div>
      <div>Sheetfed Offset Press</div>
    </div>

    <div class="border border-neutral-800 p-8">
      <div>Koenig & Bauer</div>
      <div>RA105-8+L</div>
      <div>Sheetfed Offset Press</div>
    </div>

    <div class="border border-neutral-800 p-8">
      <div>Heidelberg Speedmaster</div>
      <div>XL75-7+L</div>
      <div>Sheetfed Offset Press</div>
    </div>

    <div class="border border-neutral-800 p-8">
      <div>Koenig & Bauer</div>
      <div>RA164-5</div>
      <div>Sheetfed Offset Press</div>
    </div>
  </div>

  <SectionTitle title="" />
  <SectionTitle title="CTP Platesetters" />
  <div class="grid md:grid-cols-3 gap-8 mt-12">
    <div class="border border-neutral-800 p-8">
      <div>Eastman Kodak</div>
      <div>Trendsetter Q800AL</div>
      <div>CTP Platesetter with Autoloader</div>
    </div>

    <div class="border border-neutral-800 p-8">
      <div>Eastman Kodak</div>
      <div>Trendsetter Q1600</div>
      <div>CTP Platesetter</div>
    </div>
  </div>


  <SectionTitle title="" />
  <SectionTitle title="Guillotine Cutter" />

  <div class="grid md:grid-cols-3 gap-8 mt-12">
    <div class="border border-neutral-800 p-8">
      <div>Guowang</div>
      <div>GW137P</div>
      <div>Paper Guillotine Cutter</div>
    </div>

    <div class="border border-neutral-800 p-8">
      <div>Guowang</div>
      <div>GW137S</div>
      <div>Paper Guillotine Cutter</div>
    </div>

    <div class="border border-neutral-800 p-8">
      <div>Guowang</div>
      <div>GW176S</div>
      <div>Paper Guillotine Cutter</div>
    </div>
  </div>

</section>

</BaseLayout>