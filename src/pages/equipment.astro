---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Equipment | InChief Printing">

<section class="container-industrial py-24">

  <SectionTitle title="Production Equipment" />

  <p class="text-neutral-400 max-w-3xl mt-6">
    Our production facility is equipped with world-class offset printing systems, automated prepress workflow, and precision finishing machinery to ensure stable industrial-grade output.
  </p>

  <!-- ================= OFFSET PRESSES ================= -->
  <SectionTitle title="Offset Presses" />

  <div class="grid md:grid-cols-3 gap-8 mt-12">

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Heidelberg Speedmaster</div>
      <div class="text-neutral-300">CX 104-8 + LYY-2 + L</div>
      <div class="text-neutral-500 text-sm">High-speed sheetfed offset press</div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Heidelberg Speedmaster</div>
      <div class="text-neutral-300">XL75-6</div>
      <div class="text-neutral-500 text-sm">Precision commercial printing system</div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Heidelberg Speedmaster</div>
      <div class="text-neutral-300">XL106-6</div>
      <div class="text-neutral-500 text-sm">Large-format sheetfed offset press</div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Koenig & Bauer</div>
      <div class="text-neutral-300">Rapida 105-5+L</div>
      <div class="text-neutral-500 text-sm">Multi-color offset production line</div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Koenig & Bauer</div>
      <div class="text-neutral-300">RA105-8+L</div>
      <div class="text-neutral-500 text-sm">High-efficiency packaging printing press</div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Heidelberg Speedmaster</div>
      <div class="text-neutral-300">XL75-7+L</div>
      <div class="text-neutral-500 text-sm">Advanced color control offset system</div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Koenig & Bauer</div>
      <div class="text-neutral-300">RA164-5</div>
      <div class="text-neutral-500 text-sm">Large-format industrial printing press</div>
    </div>

  </div>

  <!-- ================= CTP ================= -->
  <SectionTitle title="CTP Platesetters" />

  <div class="grid md:grid-cols-3 gap-8 mt-12">

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Eastman Kodak</div>
      <div class="text-neutral-300">Trendsetter Q800AL</div>
      <div class="text-neutral-500 text-sm">CTP platesetter with autoloader system</div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Eastman Kodak</div>
      <div class="text-neutral-300">Trendsetter Q1600</div>
      <div class="text-neutral-500 text-sm">High-precision CTP imaging system</div>
    </div>

  </div>

  <!-- ================= CUTTING ================= -->
  <SectionTitle title="Finishing Equipment" />

  <div class="grid md:grid-cols-3 gap-8 mt-12">

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Guowang</div>
      <div class="text-neutral-300">GW137P</div>
      <div class="text-neutral-500 text-sm">Automated paper guillotine cutter</div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Guowang</div>
      <div class="text-neutral-300">GW137S</div>
      <div class="text-neutral-500 text-sm">High-precision cutting system</div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white font-medium">Guowang</div>
      <div class="text-neutral-300">GW176S</div>
      <div class="text-neutral-500 text-sm">Heavy-duty industrial cutter</div>
    </div>

  </div>

</section>

</BaseLayout>