---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="About | InChief Printing">

<section class="container-industrial py-24">
  <SectionTitle title="About Company" />

  <p class="text-neutral-400 max-w-3xl">
    InChief Printing is a modern industrial printing manufacturer focused
    on engineering precision, automation, and premium production standards.
  </p>
</section>

<section class="container-industrial py-24">
  <SectionTitle title="Factory Strength" />

  <p class="text-neutral-400 max-w-3xl">
    Equipped with advanced offset presses, finishing lines, and quality
    inspection systems.
  </p>
</section>

<section class="container-industrial py-24">
  <SectionTitle title="Development History" />

  <p class="text-neutral-400 max-w-3xl">
    Continuous innovation in industrial print manufacturing and packaging engineering.
  </p>
</section>

</BaseLayout>