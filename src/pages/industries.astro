---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../layouts/Section.astro";
import Container from "../layouts/Container.astro";
import Content from "../layouts/Content.astro";
import Grid from "../layouts/Grid.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ServiceCard from "../components/ServiceCard.astro";
---

<BaseLayout title="Industries We Serve | InChief Printing">

<!-- ================= INTRO ================= -->
<Section>
  <Container>

    <SectionTitle title="Industries We Serve" />

    <Content>
      <p class="text-neutral-400 mt-6">
        We provide high-precision printing and packaging solutions across multiple
        industries, supporting global brands with stable production capability,
        advanced technology, and scalable manufacturing systems.
      </p>
    </Content>

  </Container>
</Section>


<!-- ================= INDUSTRIES GRID ================= -->
<Section>
  <Container>
    <SectionTitle title="Case Studies" />
    <Grid cols={2}>

      <ServiceCard
        title="Food & Beverage Industry"
        description="Packaging solutions for beverages, snacks, frozen food, and premium food branding systems."
      />

      <ServiceCard
        title="Pharmaceutical Industry"
        description="GMP-compliant folding cartons, anti-counterfeit printing, and traceability packaging systems."
      />

      <ServiceCard
        title="Cosmetic Industry"
        description="Luxury cosmetic packaging with foil stamping, embossing, and premium surface finishing."
      />

      <ServiceCard
        title="Luxury Goods Industry"
        description="High-end gift boxes and brand packaging for watches, jewelry, and fashion brands."
      />

      <ServiceCard
        title="E-commerce Industry"
        description="Durable corrugated packaging designed for logistics optimization and brand experience."
      />

      <ServiceCard
        title="Commercial Printing"
        description="Marketing materials including brochures, posters, catalogs, and corporate identity systems."
      />

      <ServiceCard
        title="Publication Industry"
        description="Books, magazines, catalogs, and high-quality editorial printing with color management systems."
      />

      <ServiceCard
        title="Industrial Packaging"
        description="Heavy-duty packaging solutions for manufacturing, logistics, and export industries."
      />

    </Grid>

  </Container>
</Section>


<!-- ================= CASE HIGHLIGHTS ================= -->
<Section>
  <Container>

    <SectionTitle title="Case Highlights" />

    <Grid cols={3}>

      <ServiceCard
        title="Luxury Cosmetic Packaging"
        description="France · Premium Brand Project"
      />

      <ServiceCard
        title="Wine Label Production"
        description="Spain · UV + Embossing Process"
      />

      <ServiceCard
        title="Pharmaceutical Cartons"
        description="Germany · GMP Compliance Packaging"
      />

    </Grid>

  </Container>
</Section>


<!-- ================= CLIENT CATEGORY ================= -->
<Section>
  <Container>

    <SectionTitle title="Client Categories" />

    <Grid cols={3}>

      <ServiceCard
        title="Global Brands"
        description="International FMCG & Luxury Companies"
      />

      <ServiceCard
        title="Manufacturing Partners"
        description="OEM / ODM Industrial Clients"
      />

      <ServiceCard
        title="Regional Enterprises"
        description="Domestic & Export Trading Companies"
      />

    </Grid>

  </Container>
</Section>

</BaseLayout>