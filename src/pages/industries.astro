---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Industries | InChief Printing">

<section class="container-industrial py-24">
  <SectionTitle title="Industries We Serve" />

  <div class="grid md:grid-cols-3 gap-8 mt-12">

    <div class="border border-neutral-800 p-8">Luxury Packaging</div>
    <div class="border border-neutral-800 p-8">Food & Beverage</div>
    <div class="border border-neutral-800 p-8">Cosmetics</div>
    <div class="border border-neutral-800 p-8">Pharmaceutical</div>
    <div class="border border-neutral-800 p-8">Electronics</div>
    <div class="border border-neutral-800 p-8">Publishing</div>

  </div>

</section>

</BaseLayout>