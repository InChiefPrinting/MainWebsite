---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Industries We Serve | InChief Printing">

<section class="container-industrial py-24">

  <!-- ================= HEADER ================= -->
  <SectionTitle title="Industries We Serve" />

  <p class="text-neutral-400 max-w-3xl mt-6">
    We provide high-precision printing and packaging solutions across multiple industries, supporting global brands with stable production capability, advanced technology, and scalable manufacturing systems.
  </p>

  <!-- ================= INDUSTRIES GRID ================= -->
  <div class="grid md:grid-cols-2 gap-8 mt-12">

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white text-lg font-medium">Food & Beverage Industry</div>
      <div class="text-neutral-400 text-sm">
        Packaging solutions for beverages, snacks, frozen food, and premium food branding systems.
      </div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white text-lg font-medium">Pharmaceutical Industry</div>
      <div class="text-neutral-400 text-sm">
        GMP-compliant folding cartons, anti-counterfeit printing, and traceability packaging systems.
      </div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white text-lg font-medium">Cosmetic Industry</div>
      <div class="text-neutral-400 text-sm">
        Luxury cosmetic packaging with foil stamping, embossing, and premium surface finishing.
      </div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white text-lg font-medium">Luxury Goods Industry</div>
      <div class="text-neutral-400 text-sm">
        High-end gift boxes and brand packaging for watches, jewelry, and fashion brands.
      </div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white text-lg font-medium">E-commerce Industry</div>
      <div class="text-neutral-400 text-sm">
        Durable corrugated packaging designed for logistics optimization and brand experience.
      </div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white text-lg font-medium">Commercial Printing</div>
      <div class="text-neutral-400 text-sm">
        Marketing materials including brochures, posters, catalogs, and corporate identity systems.
      </div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white text-lg font-medium">Publication Industry</div>
      <div class="text-neutral-400 text-sm">
        Books, magazines, catalogs, and high-quality editorial printing with color management systems.
      </div>
    </div>

    <div class="border border-neutral-800 p-8 space-y-2">
      <div class="text-white text-lg font-medium">Industrial Packaging</div>
      <div class="text-neutral-400 text-sm">
        Heavy-duty packaging solutions for manufacturing, logistics, and export industries.
      </div>
    </div>

  </div>

  <!-- ================= CASE HIGHLIGHTS ================= -->
  <SectionTitle title="Case Highlights" />

  <div class="grid md:grid-cols-3 gap-8 mt-12">

    <div class="border border-neutral-800 p-6">
      <div class="text-white font-medium">Luxury Cosmetic Packaging</div>
      <div class="text-neutral-500 text-sm mt-2">France · Premium Brand Project</div>
    </div>

    <div class="border border-neutral-800 p-6">
      <div class="text-white font-medium">Wine Label Production</div>
      <div class="text-neutral-500 text-sm mt-2">Spain · UV + Embossing Process</div>
    </div>

    <div class="border border-neutral-800 p-6">
      <div class="text-white font-medium">Pharmaceutical Cartons</div>
      <div class="text-neutral-500 text-sm mt-2">Germany · GMP Compliance Packaging</div>
    </div>

  </div>

  <!-- ================= CLIENT CATEGORY ================= -->
  <SectionTitle title="Client Categories" />

  <div class="grid md:grid-cols-3 gap-8 mt-12">

    <div class="border border-neutral-800 p-6 text-center">
      <div class="text-white">Global Brands</div>
      <div class="text-neutral-500 text-sm mt-2">International FMCG & Luxury Companies</div>
    </div>

    <div class="border border-neutral-800 p-6 text-center">
      <div class="text-white">Manufacturing Partners</div>
      <div class="text-neutral-500 text-sm mt-2">OEM / ODM Industrial Clients</div>
    </div>

    <div class="border border-neutral-800 p-6 text-center">
      <div class="text-white">Regional Enterprises</div>
      <div class="text-neutral-500 text-sm mt-2">Domestic & Export Trading Companies</div>
    </div>

  </div>

</section>

</BaseLayout>