---
// Root: detect browser language and redirect to appropriate locale
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>InChief Printing</title>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/MainWebsite/en/" />
    </noscript>
  </head>
  <body>
    <script is:inline>
      const supported = ['zh', 'fr', 'ar', 'es', 'it'];
      const browserLang = (navigator.language || 'en').split('-')[0].toLowerCase();
      const lang = supported.includes(browserLang) ? browserLang : 'en';
      window.location.replace('/MainWebsite/' + lang + '/');
    </script>
  </body>
</html>
