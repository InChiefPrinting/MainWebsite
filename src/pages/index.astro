---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTA from "../components/CTA.astro";
---

<BaseLayout title="InChief Printing Tech.">

  <Hero
    title="Technology creates endless possibilities"
    subtitle={[
      "Shaping the Future of Printing with Innovation and Precision.",
      "InChief — Printing, in Chief."
    ]}
    buttonText="Request Quote"
    buttonLink="/InChief/contact"
  />

  <section class="container-industrial py-24">
    <SectionTitle title="Company Overview" />
    <p class="text-neutral-400 max-w-3xl">
      InChief Printing is an integrated high-tech printing and packaging manufacturer established in 2020 in Longgang City, Zhejiang, through the strategic alliance of four leading industrial enterprises.

The company specializes in industrial printing, advanced packaging manufacturing, and intelligent finishing solutions, supported by world-class equipment, automated production systems, and a fully integrated supply chain.

With strong engineering capability and efficient large-scale manufacturing, InChief delivers reliable, high-quality packaging solutions to global partners.
    </p>
  </section>

  <section class="container-industrial py-24 grid md:grid-cols-3 gap-8">
    <ServiceCard title="Commercial Printing" />
    <ServiceCard title="Packaging Printing" />
    <ServiceCard title="Special Finishing" />
  </section>

  <CTA />

</BaseLayout>