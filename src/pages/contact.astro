---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Contact | InChief Printing">

<section class="container-industrial py-24">

  <SectionTitle title="Contact Us" />
  
  <div class="mt-16 grid lg:grid-cols-2 gap-16 items-start">
  
    <!-- Left Info -->
    <div class="space-y-6 max-w-lg">
      <p class="text-neutral-400">
        Contact our engineering team for quotation,
        technical consultation and manufacturing solutions.
      </p>

      <div class="space-y-2 text-neutral-300">
        <p>
          <strong>Email:</strong>
            <a
              href="mailto:info@inchief.cn"
              class="hover:text-white transition"
            >
              info@inchief.cn
            </a>
        </p>

        <p>
          <strong>Phone:</strong>
            <a
              href="tel:+8657764262888"
              class="hover:text-white transition"
            >
              +86 577 6426 2888
            </a>, 
            <a
              href="tel:+8657764262999"
              class="hover:text-white transition"
            >
              +86 577 6426 2999
            </a>
        </p>

        <p>
          <strong>Address:</strong>
            2740–2828 Dongtang Road, Longgang City,
            Zhejiang Province, People’s Republic of China
        </p>
      </div>

      <!-- Map Placeholder -->
      <div class="mt-8 h-64 bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-500">
        Map Placeholder
      </div>
    </div>

    <!-- Form -->
    <form class="space-y-6 w-full max-w-xl">

      <input
        type="text"
        placeholder="Name"
        class="w-full p-4 bg-neutral-900 border border-neutral-800 focus:border-industrial-blue outline-none"
      />

      <input
        type="email"
        placeholder="Email"
        class="w-full p-4 bg-neutral-900 border border-neutral-800 focus:border-industrial-blue outline-none"
      />

      <textarea
        placeholder="Message"
        rows="6"
        class="w-full p-4 bg-neutral-900 border border-neutral-800 focus:border-industrial-blue outline-none"
      >
      </textarea>

      <button
        type="submit"
        class="px-8 py-4 bg-industrial-blue hover:opacity-90 transition"
      >
        Send Message
      </button>
    </form>
  </div>
</section>

</BaseLayout>